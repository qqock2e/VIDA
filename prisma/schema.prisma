generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model LeaderboardEntry {
  id         String   @id @default(cuid())
  nickname   String
  points     Int
  round      Int
  difficulty String
  mode       String   @default("normal")
  life       Float    @default(0)
  createdAt  DateTime @default(now())
}
